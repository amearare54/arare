DT_COMPAT_ARARE_BATTERY_VOLTAGE_DIVIDER := arare,battery-voltage-divider

# arare 独自設定

menuconfig ARARE_BATTERY_LED
    bool "arare: 電池残量をマイコンのLEDで知らせる"
    depends on ZMK_BATTERY_REPORTING
    help
      XIAO nRF52840 内蔵のRGB LEDで電池残量を色で示す。
      常時点灯はせず、起動直後・スリープ復帰時に短く点灯し、
      残量が少ないときだけ定期的に赤く点滅して充電を促す。
      USB接続中は残量色を点灯したままにする。

if ARARE_BATTERY_LED

config ARARE_BATTERY_LED_GOOD_PCT
    int "この値以上を緑にする(%)"
    default 60

config ARARE_BATTERY_LED_LOW_PCT
    int "この値以下で充電を促す(%)"
    default 20

config ARARE_BATTERY_LED_CRITICAL_PCT
    int "この値以下は警告を強める(%)"
    default 10

config ARARE_BATTERY_LED_GLANCE_MS
    int "起動時・復帰時に残量色を点灯する時間(ミリ秒)"
    default 1500

config ARARE_BATTERY_LED_WARN_INTERVAL_SEC
    int "残量が少ないときの警告間隔(秒)"
    default 300

config ARARE_BATTERY_LED_CRITICAL_INTERVAL_SEC
    int "残量が危険域のときの警告間隔(秒)"
    default 120

endif # ARARE_BATTERY_LED

# arare 独自の電池電圧ドライバ（SAADCのオーバーサンプリングを無効化した版）
# デバイスツリーに arare,battery-voltage-divider のノードがあれば自動で有効になる。
# ジョイスティックのアナログXYと電池計測を共存させるためのもの。理由は arare_L.conf 参照。
config ARARE_BATTERY_VOLTAGE_DIVIDER
    bool
    default $(dt_compat_enabled,$(DT_COMPAT_ARARE_BATTERY_VOLTAGE_DIVIDER))
    select ADC
    select ZMK_BATTERY
    depends on SENSOR
    help
      ZMK本家の battery_voltage_divider と同一だが oversampling=0。
      本家を fork せずに済ませるため設定リポジトリ側にドライバを持つ。
