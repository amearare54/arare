/*
 * arare keymap — arare Studio で生成（2026-09-07）
 * 配列: USホスト向け
 *
 * ポジション順は arare.dtsi のコメント参照（47キー×4レイヤー）。
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            display-name = "L0";
            bindings = <
&kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P
&kp A  &kp S  &kp D  &kp F  &kp G  &kp LS(LG(V))  &mkp LCLK  &kp H  &kp J  &kp K  &kp L  &kp MINUS
&mt LSHFT Z  &kp X  &kp C  &kp V  &kp B  &mo 2  &mkp RCLK  &kp N  &kp M  &kp COMMA  &kp DOT  &kp AT
&kp LANG2  &mt LALT LCTRL  &kp LGUI  &kp SPACE  &mo 1  &mo 3  &kp ENTER  &kp BSPC  &kp LANG1
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &studio_unlock
            >;
            sensor-bindings = <&inc_dec_kp LG(EQUAL) LG(MINUS)>, <&inc_dec_kp PG_UP PG_DN>;
        };

        layer_1 {
            display-name = "L1";
            bindings = <
&kp ESC  &trans  &trans  &trans  &trans  &kp LPAR  &kp RPAR  &kp EXCL  &kp QMARK  &kp EQUAL
&kp TAB  &trans  &trans  &trans  &trans  &trans  &trans  &kp LBKT  &kp RBKT  &kp HASH  &kp PRCNT  &kp FSLH
&trans  &trans  &trans  &trans  &trans  &trans  &kp DQT  &kp SEMI  &kp COLON  &kp AMPS  &kp SQT  &kp UNDER
&kp CAPS  &trans  &trans  &trans  &trans  &trans  &kp GLOBE  &kp DEL  &kp ASTRK
&kp F13  &kp F14  &kp F15  &kp F16
            >;
            sensor-bindings = <&inc_dec_kp LG(EQUAL) LG(MINUS)>, <&inc_dec_kp PG_UP PG_DN>;
        };

        layer_2 {
            display-name = "L2";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp N7  &kp N8  &kp N9
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp UP  &trans  &kp N4  &kp N5  &kp N6
&trans  &trans  &trans  &trans  &trans  &trans  &kp LEFT  &kp DOWN  &kp RIGHT  &kp N1  &kp N2  &kp N3
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp N0
&trans  &trans  &trans  &trans
            >;
            sensor-bindings = <&inc_dec_kp C_BRI_UP C_BRI_DN>, <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        layer_3 {
            display-name = "L3";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans
            >;
        };
    };
};
