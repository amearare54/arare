/* arare チューニング（左手）: 左エンコーダ＋ジョイスティック（受け口）
 *
 * このファイルは arare Studio の「設定」パネルが生成するテキストでまるごと差し替える運用。
 * 既定値 = 現状維持。
 */

/* 左エンコーダ（EC12・縦）の分解能と感度 */
&left_encoder {
    steps = <12>;
};

&sensors {
    triggers-per-rotation = <10>;
};

/* ジョイスティックを付けている構成。
 * 電池ドライバを oversampling=0 の arare 版へ差し替えて SAADC の停止を避ける。
 * 理由と代償は arare_L.conf のコメントを参照。
 * ★付けない構成では arare Studio がこのincludeを出さず、代わりに
 *   &joystick / &joystick_split を disabled にする。 */
#include "arare_saadc_fix.dtsi"

/* ---- ジョイスティック（アナログXY）----
 * 中点・振れ幅・軸の向きは実測済みで、arare_L.overlay に置いてある（Studio の再生成で消えないように）。
 * ここで変えるのは中央の遊びだけ。
 *   mv-deadzone: 手を離しても勝手に反応するなら大きく（uint8_t 格納なので 255 以下）。
 *   実測では離すたびの戻り位置が最大 ±40 mV ずれるので、100 で余裕がある。
 *   ※ scale-divisor（4/280）の切り捨てで、さらに 70 mV ぶんの遊びが上乗せされる。
 */
&joy_x {
    mv-deadzone = <100>;
};

&joy_y {
    mv-deadzone = <100>;
};
