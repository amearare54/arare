/* arare チューニング（左手）— ★切り分け用（test-L-nojoy ブランチ限定）
 *
 * ジョイスティックを外した構成（arare Studio の BUILD パネル「普通のキー」と同じ中身）。
 * 左右が繋がらない原因が、左手のジョイスティック／SAADC まわりで左手の処理が止まり、
 * split の広告が出ていないことか確かめる。
 *
 * 根拠（2026-09-22 実機ログ）: 右手のスキャンは正常で周囲23台を検出しているが、
 * Found the split service が一度も出ない＝左手の広告が一度も届いていない。
 */

/* 左エンコーダ（EC12・縦）の分解能と感度 */
&left_encoder {
    steps = <12>;
};

&sensors {
    triggers-per-rotation = <10>;
};

/* ジョイスティックを付けていない構成。アナログ入力と中継を無効にする。
 * 電池ドライバの差し替え（arare_saadc_fix.dtsi）も行わない＝本家のまま。 */
&joystick {
    status = "disabled";
};

&joystick_split {
    status = "disabled";
};
