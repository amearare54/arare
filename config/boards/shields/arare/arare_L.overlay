/* arare 左手（peripheral）
 * M0=D0 M1=D1 M2=D6 M3=D7 M4=D8 M5=D9 / EC12=D2,D3 / JOY_SW=D10
 * （実基板 arare_L.kicad_pcb の XIAO パッド→ネットと機械照合済み 2026-08-31）
 */

#include "arare.dtsi"

#include <zephyr/dt-bindings/input/input-event-codes.h>

/* 電池ドライバの差し替え（arare_saadc_fix.dtsi）は arare_tuning_L.dtsi 側で行う。
 * ジョイスティックを付けない構成では差し替えないため、arare Studio が構成に応じて出し分ける。 */

&kscan_matrix {
    gpios
        = <&xiao_d 0 GPIO_ACTIVE_HIGH>   /* M0 */
        , <&xiao_d 1 GPIO_ACTIVE_HIGH>   /* M1 */
        , <&xiao_d 6 GPIO_ACTIVE_HIGH>   /* M2 */
        , <&xiao_d 7 GPIO_ACTIVE_HIGH>   /* M3 */
        , <&xiao_d 8 GPIO_ACTIVE_HIGH>   /* M4 */
        , <&xiao_d 9 GPIO_ACTIVE_HIGH>   /* M5 */
        ;
};

/ {
    /* ジョイスティック押込（D10-GND直結）。デュアルFP時のChocスイッチも同じ線 */
    kscan_direct: kscan_direct {
        compatible = "zmk,kscan-gpio-direct";
        input-gpios = <&xiao_d 10 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
    };

    /* ジョイスティック NS40-T のアナログXY（2026-09-05）
     *   /L_JOY_X = XIAO pad5 = D4 = P0.04 = AIN2
     *   /L_JOY_Y = XIAO pad6 = D5 = P0.05 = AIN3
     *   （実基板 arare_L.kicad_pcb のネットと seeed_xiao_connector.dtsi で照合済み）
     *
     * ★★ 子ノードは io-channels のチャネル番号の昇順で並べること ★★
     *   ドライバは adc_read を1回だけ発行し、結果を as_buff[子ノードのindex] で読む。
     *   一方 SAADC はバッファへチャネル番号の昇順で詰める。
     *   よって AIN2 を先、AIN3 を後にしないと X と Y が入れ替わる。
     *
     * ★ report-on-change-only は絶対に付けないこと。
     *   付けると「倒し続けても最初の1回しか動かない」挙動になる。
     *
     * 実機合わせの数値（mv-mid / mv-min-max / mv-deadzone / scale / invert）は
     * arare_tuning_L.dtsi 側で上書きする。ここは必須プロパティと安全側の初期値のみ。 */
    joystick: analog_input_0 {
        compatible = "zmk,analog-input";
        status = "okay";
        sampling-hz = <100>;

        joy_x: x-ch {                      /* 昇順1番目: AIN2 */
            io-channels = <&adc 2>;
            mv-mid = <1650>;               /* 3V3/2。実機で確定させる */
            mv-min-max = <1200>;
            mv-deadzone = <60>;            /* uint8_t 格納なので 255 以下 */
            scale-multiplier = <4>;
            scale-divisor = <280>;         /* 1/70 と同比のまま分解能を上げてある */
            evt-type = <INPUT_EV_REL>;
            input-code = <INPUT_REL_X>;
        };

        joy_y: y-ch {                      /* 昇順2番目: AIN3 */
            io-channels = <&adc 3>;
            mv-mid = <1650>;
            mv-min-max = <1200>;
            mv-deadzone = <60>;
            scale-multiplier = <4>;
            scale-divisor = <280>;
            evt-type = <INPUT_EV_REL>;
            input-code = <INPUT_REL_Y>;
        };
    };
};

/* peripheral(左)側は device の指定が必須。
 * ここに input-processors を足す場合、state が NULL で渡るため
 * scaler は端数が捨てられ、behaviors 系は NULL 参照で落ちる。
 * 速度・加速は central(右) 側の &joystick_listener に置くこと。 */
&joystick_split {
    device = <&joystick>;
};

&kscan0 {
    joy {
        kscan = <&kscan_direct>;
        row-offset = <6>;
    };
};

&left_encoder {
    status = "okay";
};

/* 左エンコーダ・ジョイスティックの詳細設定は別ファイルに分離。
 * arare Studio の生成テキストで差し替える */
#include "arare_tuning_L.dtsi"
