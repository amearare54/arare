/* arare 左手（peripheral）
 * M0=D0 M1=D1 M2=D6 M3=D7 M4=D8 M5=D9 / EC12=D2,D3 / JOY_SW=D10
 * （実基板 arare_L.kicad_pcb の XIAO パッド→ネットと機械照合済み 2026-08-31）
 */

#include "arare.dtsi"

&kscan_matrix {
    gpios
        = <&xiao_d 0 GPIO_ACTIVE_HIGH>   /* M0 */
        , <&xiao_d 1 GPIO_ACTIVE_HIGH>   /* M1 */
        , <&xiao_d 6 GPIO_ACTIVE_HIGH>   /* M2 */
        , <&xiao_d 7 GPIO_ACTIVE_HIGH>   /* M3 */
        , <&xiao_d 8 GPIO_ACTIVE_HIGH>   /* M4 */
        , <&xiao_d 9 GPIO_ACTIVE_HIGH>   /* M5 */
        ;
};

/ {
    /* ジョイスティック押込（D10-GND直結）。デュアルFP時のChocスイッチも同じ線 */
    kscan_direct: kscan_direct {
        compatible = "zmk,kscan-gpio-direct";
        input-gpios = <&xiao_d 10 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
    };
};

&kscan0 {
    joy {
        kscan = <&kscan_direct>;
        row-offset = <6>;
    };
};

&left_encoder {
    status = "okay";
};

/* 左エンコーダ・ジョイスティックの詳細設定は別ファイルに分離。
 * arare Studio の生成テキストで差し替える */
#include "arare_tuning_L.dtsi"
